.moment { border-radius: 32rpx; background: #fff; overflow: hidden; }
.moment .photo-frame { border-radius: 0; }
.moment-body { padding: 30rpx; }
.moment-number { display: inline-block; background: #eabca5; color: #58483f; font-size: 22rpx; padding: 5rpx 20rpx; border-radius: 6rpx; }
.quote { display: block; font-size: 36rpx; line-height: 1.6; margin: 24rpx 0 20rpx; }
