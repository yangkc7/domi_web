@import "styles/cute-font.wxss";
page { background: #f8f5ee; color: #253341; font-family: "DomiCute", "YouYuan", "PingFang SC", sans-serif; font-size: 28rpx; line-height: 1.65; }
button, input, textarea, picker { font-family: inherit; }
view, text, button, input, textarea { box-sizing: border-box; }
button { margin: 0; font-size: 28rpx; line-height: 1.5; }
button::after { border: 0; }
button[disabled] { opacity: .5; }
.page { padding: 36rpx 32rpx 64rpx; }
.tab-page { padding-bottom: 180rpx; padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.eyebrow { display: block; color: #4f7088; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 20rpx; letter-spacing: 4rpx; font-weight: 600; margin-bottom: 12rpx; }
.title { font-size: 58rpx; font-weight: 600; line-height: 1.3; display: block; }
.subtitle { display: block; color: #687582; font-size: 26rpx; margin-top: 16rpx; }
.section { margin-top: 44rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.section-title { font-size: 34rpx; font-weight: 600; }
.card { border: 1rpx solid #e8e8df; background: #ffffff; border-radius: 28rpx; padding: 28rpx; }
.muted { color: #687582; }
.small { font-size: 23rpx; }
.block { display: block; }
.primary { color: #fff; background: #4f7088; padding: 23rpx 32rpx; border-radius: 50rpx; font-weight: 600; }
.secondary { background: #dbe8ee; color: #4f7088; padding: 22rpx 30rpx; border-radius: 50rpx; }
.text-button { background: transparent; color: #4f7088; padding: 10rpx 0 10rpx 20rpx; font-size: 25rpx; }
.tag { display: inline-block; border-radius: 30rpx; background: #edf3f5; color: #4f7088; padding: 4rpx 17rpx; font-size: 21rpx; }
.photo { width: 100%; display: block; height: auto; background: #dbe8ee; }
.photo-frame { border-radius: 24rpx; overflow: hidden; }
.footer { color: #82909a; text-align: center; font-size: 23rpx; margin-top: 44rpx; }
.page-actions { display: flex; gap: 16rpx; margin-top: 30rpx; }
.page-actions button { flex: 1; }
.error-note { margin-top: 16rpx; color: #9a5b42; font-size: 24rpx; }
